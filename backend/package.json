{
  "name": "interntrack-backend",
  "version": "1.0.0",
  "description": "REST API InternTrack — Pelacak Lamaran Magang (Express.js + SQLite)",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "oxlint": "^1.0.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
