# Mode aplikasi: development | production | test
NODE_ENV=development
# Port server Express
PORT=3000
# Lokasi berkas SQLite (folder dibuat otomatis)
DB_PATH=./data/interntrack.db
# WAJIB diganti di produksi (minimal 32 karakter acak)
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
# Origin front-end yang diizinkan (pisahkan dengan koma). Gunakan * untuk semua origin.
CORS_ORIGIN=http://localhost:5173
